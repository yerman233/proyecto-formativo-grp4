---
import "../style/juego.css";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#111022" />
		<title>Ritmo perdido | Juego</title>
	</head>
	<body>
		<main class="game-shell">
			<header class="topbar">
				<a class="brand" href="/">♫ <span>Ritmo perdido</span></a>
				<nav aria-label="Navegación"><a href="/">Inicio</a><a href="/nuestra_musica">Nuestra música</a><a href="/reglas_juego">Reglas</a></nav>
			</header>
			<section class="intro">
				<div><p class="eyebrow">AVENTURA MUSICAL · 2D</p><h1>Recupera el <span>ritmo.</span></h1><p class="lede">Explora la ciudad, recoge los discos perdidos y arma tu propia banda sonora.</p></div>
				<div class="stats"><div><b id="score">0</b><small>CANCIONES</small></div><div><b>♫</b><small>ENCUÉNTRALAS</small></div></div>
			</section>
			<section class="layout" aria-label="Juego y canciones">
				<div class="play-column">
					<div class="game-frame">
						<div class="scene-label"><span class="live-dot"></span> BARRIO NEÓN <span class="scene-time">NOCHE 01</span></div>
						<canvas id="game" aria-label="Juego 2D: usa las flechas o WASD para recolectar discos" width="800" height="450"></canvas>
						<div class="overlay" id="overlay"><div class="overlay-card"><span class="big-note">♫</span><h2>La ciudad perdió su música</h2><p>Encuentra los discos brillantes. Cada canción que recuperes empezará a sonar.</p><button id="start">Comenzar aventura <span>→</span></button></div></div>
					</div>
					<div class="controls"><span><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> o <kbd>↑</kbd><kbd>←</kbd><kbd>↓</kbd><kbd>→</kbd> <small>MOVERSE</small></span><span class="hint">Recoge los discos ✦</span></div>
					<div class="touch-controls" aria-label="Controles táctiles"><button data-dir="up" aria-label="Arriba">↑</button><button data-dir="left" aria-label="Izquierda">←</button><button data-dir="down" aria-label="Abajo">↓</button><button data-dir="right" aria-label="Derecha">→</button></div>
				</div>
				<aside class="playlist"><div class="playlist-head"><div><p class="eyebrow">TU COLECCIÓN</p><h2>Discos recuperados</h2></div><span id="count">0 / 5</span></div><p class="playlist-note">La música se activa al encontrar cada disco.</p><div id="tracks" class="tracks"><div class="empty-note">Aún no hay canciones.<br />¡Sal a explorar!</div></div><div class="player"><button id="play" aria-label="Reproducir o pausar" disabled>▶</button><div class="track-info"><b id="now-playing">Sin música</b><small id="player-state">Encuentra un disco para empezar</small></div><span class="volume">♫</span></div><button id="mute" class="mute" disabled>♫ Silenciar música</button></aside>
			</section>
			<footer>Un paseo nocturno para volver a encontrar el sonido.</footer>
		</main>
		<script>
			const canvas = document.querySelector<HTMLCanvasElement>("#game")!;
			const ctx = canvas.getContext("2d")!;
			const tracks = [
				{ title: "Luces de la ciudad", artist: "Neón · 02:41", color: "#ffcc68", notes: [261.6, 329.6, 392, 329.6] },
				{ title: "Primer acorde", artist: "Amanecer · 02:18", color: "#ff76b8", notes: [293.7, 349.2, 440, 349.2] },
				{ title: "Lluvia de verano", artist: "Frecuencia · 03:04", color: "#7de7df", notes: [220, 277.2, 330, 277.2] },
				{ title: "Último tren", artist: "Medianoche · 02:56", color: "#a896ff", notes: [246.9, 311.1, 370, 311.1] },
				{ title: "Volver a sonar", artist: "Ritmo · 03:12", color: "#ff9274", notes: [196, 246.9, 293.7, 246.9] },
			];
			const spots = [{x: .18,y: .27},{x: .79,y: .22},{x: .64,y: .78},{x: .29,y: .72},{x: .48,y: .43}];
			let found: number[] = [], x = 400, y = 225, running = false, muted = false, active = 0, audio: AudioContext | undefined, step = 0;
			const keys = new Set<string>();
			function draw() {
				const w = canvas.width, h = canvas.height;
				const sky = ctx.createLinearGradient(0,0,0,h); sky.addColorStop(0,"#17152f"); sky.addColorStop(1,"#292344"); ctx.fillStyle=sky; ctx.fillRect(0,0,w,h);
				ctx.fillStyle="#1b1a31"; ctx.fillRect(0,265,w,185);
				// Street and perspective
				ctx.fillStyle="#242139"; ctx.beginPath(); ctx.moveTo(265,265);ctx.lineTo(535,265);ctx.lineTo(730,450);ctx.lineTo(70,450);ctx.fill();
				ctx.strokeStyle="rgba(255,255,255,.07)";ctx.lineWidth=2; for(let i=0;i<7;i++){const yy=285+i*i*4;ctx.beginPath();ctx.moveTo(0,yy);ctx.lineTo(w,yy);ctx.stroke();}
				// Buildings
				for(let b=0;b<6;b++){let bx=b*145-20,bh=105+(b*37%90);ctx.fillStyle=b%2?"#211f3a":"#19182f";ctx.fillRect(bx,265-bh,115,bh);ctx.fillStyle=b%2?"#46416d":"#ff9b6e";ctx.globalAlpha=.7;ctx.fillRect(bx+15,280-bh,3,24);ctx.globalAlpha=.35;for(let wy=0;wy<bh-18;wy+=23)for(let wx=0;wx<80;wx+=25){ctx.fillStyle=(wx+wy+b)%3?"#7766ad":"#ffca78";ctx.fillRect(bx+18+wx,275-bh+wy,8,7);}ctx.globalAlpha=1;}
				// Street lamps
				for(const lx of [118,680]){ctx.strokeStyle="#77708e";ctx.lineWidth=4;ctx.beginPath();ctx.moveTo(lx,256);ctx.lineTo(lx,155);ctx.lineTo(lx+24,145);ctx.stroke();ctx.fillStyle="#ffd88b";ctx.shadowColor="#ffc56f";ctx.shadowBlur=22;ctx.beginPath();ctx.arc(lx+25,145,6,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;}
				// collectible records
				spots.forEach((s,i)=>{if(found.includes(i))return;let sx=s.x*w,sy=s.y*h,pulse=Math.sin(Date.now()/260+i)*3;ctx.shadowColor=tracks[i].color;ctx.shadowBlur=20;ctx.fillStyle=tracks[i].color;ctx.beginPath();ctx.arc(sx,sy+pulse,12,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;ctx.fillStyle="#27213d";ctx.beginPath();ctx.arc(sx,sy+pulse,5,0,Math.PI*2);ctx.fill();ctx.fillStyle="#fff";ctx.font="12px sans-serif";ctx.fillText("✦",sx+12,sy-10+pulse);});
				// player
				ctx.fillStyle="rgba(255,117,184,.2)";ctx.beginPath();ctx.ellipse(x,y+14,17,7,0,0,Math.PI*2);ctx.fill();ctx.fillStyle="#ff77b7";ctx.beginPath();ctx.arc(x,y-4,10,0,Math.PI*2);ctx.fill();ctx.fillStyle="#ffd5e8";ctx.fillRect(x-7,y+5,14,15);ctx.fillStyle="#fff";ctx.fillRect(x-4,y-7,3,3);ctx.fillRect(x+2,y-7,3,3);
				if(running){if(keys.has("arrowleft")||keys.has("a"))x-=2.7;if(keys.has("arrowright")||keys.has("d"))x+=2.7;if(keys.has("arrowup")||keys.has("w"))y-=2.7;if(keys.has("arrowdown")||keys.has("s"))y+=2.7;x=Math.max(20,Math.min(w-20,x));y=Math.max(170,Math.min(h-22,y));spots.forEach((s,i)=>{if(!found.includes(i)&&Math.hypot(x-s.x*w,y-s.y*h)<27)collect(i);});}
				requestAnimationFrame(draw);
			}
			function collect(i:number){found.push(i);document.querySelector("#score")!.textContent=String(found.length);document.querySelector("#count")!.textContent=`${found.length} / 5`;const row=document.createElement("button");row.className="track";row.innerHTML=`<span class="vinyl" style="--tone:${tracks[i].color}">♫</span><span><b>${tracks[i].title}</b><small>${tracks[i].artist}</small></span><span class="track-play">▶</span>`;row.onclick=()=>playTrack(i);document.querySelector("#tracks")!.querySelector(".empty-note")?.remove();document.querySelector("#tracks")!.append(row);playTrack(i);if(found.length===5){document.querySelector("#player-state")!.textContent="¡Colección completa!";}}
			function playTrack(i:number){active=i;document.querySelector("#now-playing")!.textContent=tracks[i].title;document.querySelector("#player-state")!.textContent="Reproduciendo · " + tracks[i].artist;document.querySelector<HTMLButtonElement>("#play")!.disabled=false;document.querySelector<HTMLButtonElement>("#mute")!.disabled=false;if(!muted){if(!audio)audio=new AudioContext();audio.resume();step=0;sequence();}}
			function sequence(){if(muted||!found.includes(active))return;const ac=audio!;const osc=ac.createOscillator(),gain=ac.createGain();osc.type="sine";osc.frequency.value=tracks[active].notes[step%4];gain.gain.setValueAtTime(.0001,ac.currentTime);gain.gain.exponentialRampToValueAtTime(.045,ac.currentTime+.025);gain.gain.exponentialRampToValueAtTime(.0001,ac.currentTime+.3);osc.connect(gain);gain.connect(ac.destination);osc.start();osc.stop(ac.currentTime+.31);step++;setTimeout(sequence,360);}
			document.querySelector("#start")!.addEventListener("click",()=>{running=true;document.querySelector("#overlay")!.classList.add("hidden");});
			document.querySelector("#play")!.addEventListener("click",()=>{if(audio?.state==="running")audio.suspend();else if(audio)audio.resume();});
			document.querySelector("#mute")!.addEventListener("click",(e)=>{muted=!muted;(e.currentTarget as HTMLButtonElement).textContent=muted?"♫ Activar música":"♫ Silenciar música";if(!muted&&found.length)playTrack(active);});
			window.addEventListener("keydown",e=>{const k=e.key.toLowerCase();if(["arrowup","arrowdown","arrowleft","arrowright","w","a","s","d"].includes(k)){e.preventDefault();keys.add(k);}});window.addEventListener("keyup",e=>keys.delete(e.key.toLowerCase()));
			document.querySelectorAll<HTMLButtonElement>(".touch-controls button").forEach(btn=>{const map:Record<string,string>={up:"arrowup",down:"arrowdown",left:"arrowleft",right:"arrowright"};btn.addEventListener("pointerdown",()=>keys.add(map[btn.dataset.dir!]));["pointerup","pointerleave","pointercancel"].forEach(ev=>btn.addEventListener(ev,()=>keys.delete(map[btn.dataset.dir!])));});
			draw();
		</script>
	</body>
</html>
