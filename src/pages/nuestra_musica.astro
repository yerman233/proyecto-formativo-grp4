---
import HeaderAstroComponent from "../components/Header.astro";
import FooterAstroComponent from "../components/Footer.astro";
import "../style/global.css";

const lanzamientos = [
	{
		numero: "01",
		tipo: "SENCILLO",
		anio: "2024",
		titulo: "Primer Acorde",
		simbolo: "Ⅰ",
		estilo: "release-one",
		descripcion: "El comienzo de nuestro recorrido musical.",
	},
	{
		numero: "02",
		tipo: "SENCILLO",
		anio: "2024",
		titulo: "Luces de la Ciudad",
		simbolo: "Ⅱ",
		estilo: "release-two",
		descripcion: "Una nueva pieza de nuestro sonido en construcción.",
	},
	{
		numero: "03",
		tipo: "EP DEBUT",
		anio: "2025",
		titulo: "Nuestra Esencia",
		simbolo: "✳",
		estilo: "release-three",
		descripcion: "Una colección que reúne lo que somos como banda.",
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Descubre los sencillos y el EP de Too Late Again."
		/>
		<title>Nuestra música | Too Late Again</title>
	</head>
	<body>
		<HeaderAstroComponent />
		<main>
			<section class="hero">
				<p class="eyebrow">03 — LO QUE SUENA</p>
				<h1>Canciones para<br />poner en <em>repeat.</em></h1>
				<p class="intro">
					Cada lanzamiento marca una parte de nuestro camino. Este es el
					sonido de Too Late Again, hecho para compartir.
				</p>
				<a class="text-link" href="#lanzamientos">Ver lanzamientos <span aria-hidden="true">↓</span></a>
			</section>

			<section class="catalog section-wrap" id="lanzamientos" aria-labelledby="catalog-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">NUESTRO CATÁLOGO</p>
						<h2 id="catalog-title">De la primera nota<br />a <em>nuestra esencia.</em></h2>
					</div>
					<p class="section-description">
						Sencillos y el EP debut que representan los lanzamientos
						mencionados en nuestra historia.
					</p>
				</div>
				<div class="release-list">
					{lanzamientos.map((lanzamiento) => (
						<article class="release">
							<span class="release-number">{lanzamiento.numero}</span>
							<div class={`release-art ${lanzamiento.estilo}`} aria-hidden="true">
								{lanzamiento.simbolo}
							</div>
							<div class="release-info">
								<p>{lanzamiento.tipo} · {lanzamiento.anio}</p>
								<h3>{lanzamiento.titulo}</h3>
								<span>{lanzamiento.descripcion}</span>
							</div>
							<span class="release-mark" aria-hidden="true">♪</span>
						</article>
					))}
				</div>
				<p class="catalog-note">
					Estamos preparando más música para compartir. Gracias por
					acompañarnos en el camino.
				</p>
			</section>

			<section class="closing">
				<p class="eyebrow">¿YA CONOCES A LA BANDA?</p>
				<h2>Detrás de cada nota<br />hay una <em>historia.</em></h2>
				<a class="button" href="/nosotros">Conócenos <span aria-hidden="true">↗</span></a>
			</section>
		</main>
		<FooterAstroComponent />
	</body>
</html>

<style>
	main {
		overflow: hidden;
	}

	.hero {
		padding: clamp(5rem, 12vw, 10rem) clamp(1.5rem, 10vw, 10rem);
		border-bottom: 1px solid var(--line);
		background:
			radial-gradient(ellipse at 78% 30%, #75452f38 0, transparent 35rem),
			#171615;
	}

	.eyebrow {
		margin: 0 0 1.4rem;
		color: var(--accent);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	.hero h1 {
		margin-bottom: 1.5rem;
		font-size: clamp(3.5rem, 8vw, 7.5rem);
		font-weight: 500;
		letter-spacing: -0.08em;
		line-height: 0.98;
	}

	h1 em,
	h2 em {
		color: var(--accent);
		font-family: Georgia, "Times New Roman", serif;
		font-weight: 400;
	}

	.intro {
		max-width: 540px;
		margin-bottom: 1.5rem;
		color: #bdb6ae;
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.text-link {
		color: var(--ink);
		font-size: 0.85rem;
		text-decoration: none;
	}

	.text-link span {
		padding-left: 0.4rem;
		color: var(--accent);
	}

	.section-wrap {
		width: min(100% - 3rem, 1120px);
		margin-inline: auto;
		padding-block: clamp(5rem, 10vw, 8rem);
	}

	.catalog {
		border-bottom: 1px solid var(--line);
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 3rem;
	}

	.section-heading h2,
	.closing h2 {
		margin-bottom: 0;
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 500;
		letter-spacing: -0.07em;
		line-height: 1.03;
	}

	.section-description {
		max-width: 340px;
		margin: 0 0 0.2rem;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.8;
	}

	.release-list {
		border-top: 1px solid var(--line);
	}

	.release {
		display: grid;
		grid-template-columns: 30px 84px minmax(0, 1fr) 24px;
		align-items: center;
		gap: 1.2rem;
		padding: 1.2rem 0;
		border-bottom: 1px solid var(--line);
	}

	.release-number {
		color: #827b73;
		font-size: 0.65rem;
	}

	.release-art {
		display: grid;
		width: 84px;
		aspect-ratio: 1;
		place-items: center;
		color: #f0c9a1;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 2rem;
	}

	.release-one {
		background: linear-gradient(135deg, #855d40, #28201b);
	}

	.release-two {
		background: linear-gradient(145deg, #9b7652, #27201e 70%);
	}

	.release-three {
		background: linear-gradient(135deg, #b66c54, #47302f);
	}

	.release-info > p {
		margin-bottom: 0.3rem;
		color: var(--accent);
		font-size: 0.6rem;
		letter-spacing: 0.13em;
	}

	.release-info h3 {
		margin-bottom: 0.4rem;
		font-size: 1.2rem;
		font-weight: 500;
	}

	.release-info > span {
		color: var(--muted);
		font-size: 0.8rem;
		line-height: 1.6;
	}

	.release-mark {
		color: var(--accent);
		font-size: 1.2rem;
	}

	.catalog-note {
		margin: 1.5rem 0 0;
		color: var(--muted);
		font-size: 0.8rem;
		line-height: 1.7;
	}

	.closing {
		padding: clamp(4rem, 9vw, 7rem) 1.5rem;
		text-align: center;
		background: radial-gradient(ellipse at 50% 100%, #75452f30, transparent 60%);
	}

	.closing h2 {
		margin-bottom: 2rem;
	}

	.button {
		display: inline-flex;
		min-height: 48px;
		align-items: center;
		gap: 1rem;
		padding: 0.8rem 1.15rem;
		background: var(--accent);
		color: #201712;
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 180ms ease, background 180ms ease;
	}

	.button:hover {
		transform: translateY(-2px);
		background: #f3b887;
	}

	@media (max-width: 760px) {
		.section-heading {
			align-items: start;
			flex-direction: column;
		}
	}

	@media (max-width: 480px) {
		.release {
			grid-template-columns: 22px 64px minmax(0, 1fr);
			gap: 0.8rem;
		}

		.release-art {
			width: 64px;
		}

		.release-mark {
			display: none;
		}
	}
</style>